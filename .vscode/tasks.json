{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: build Debug",
      "type": "shell",
      "command": "& 'C:\\Program Files\\Microsoft Visual Studio\\18\\Insiders\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\CMake\\bin\\cmake.exe' --build build-vcpkg --config Debug --parallel",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run renderer",
      "type": "shell",
      "command": "& '${workspaceFolder}\\build-vcpkg\\Debug\\3d-renderer.exe'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "cmake: build Debug",
      "problemMatcher": []
    }
  ]
}
